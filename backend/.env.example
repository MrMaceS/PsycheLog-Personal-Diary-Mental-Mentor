ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/app_db

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://app_user:app_password@localhost:5672/app_vhost

# JWT
JWT_SECRET_KEY=replace_me_with_secure_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# PIN security
PIN_MAX_ATTEMPTS=4
PIN_FREEZE_AFTER_ATTEMPTS=3
PIN_FREEZE_MINUTES=10

# OTP
OTP_EXPIRE_MINUTES=10
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=3

# AI providers
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# S3 (MinIO for local dev)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace_me
S3_BUCKET=app-media
S3_REGION=us-east-1

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Encryption
ENCRYPTION_MASTER_KEY=replace_me_with_32_byte_key

# Logging
LOG_LEVEL=INFO